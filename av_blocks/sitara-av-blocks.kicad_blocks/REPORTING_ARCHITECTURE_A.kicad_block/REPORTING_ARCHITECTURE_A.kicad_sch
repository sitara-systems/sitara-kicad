			(justify left top)
		)
		(uuid "79faf82a-c75f-55bd-beab-dc4f9a43b3fd")
	)
	(text_box "StarWatch only connects out to Pub/Sub; the site accepts no inbound connection from the cloud. Photon and Electron stay on the application node (local to the app). The surveyor's MeshCentral stays on the LAN."
		(exclude_from_sim no)
		(at 20 263.21 0)
		(size 270 10.21)
		(margins 1.8175 1.8175 1.8175 1.8175)
		(stroke
