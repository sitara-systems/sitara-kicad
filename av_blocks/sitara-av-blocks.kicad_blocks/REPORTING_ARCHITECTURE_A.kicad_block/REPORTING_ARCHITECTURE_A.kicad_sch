			)
			(justify left top)
		)
		(uuid "869e196c-da3b-5f86-b989-e10243208f41")
	)
	(text_box "Why two clients: the application-node client keeps the show running and reports on it; the surveyor client watches the hardware around it and can recover the application node when its own client cannot."
		(exclude_from_sim no)
